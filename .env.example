# Runtime
ENVIRONMENT=local
PORT=3000
LOG_LEVEL=info

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=eid
POSTGRES_PASSWORD=eid
POSTGRES_DATABASE=eid

# Local disk storage (uploads)
STORAGE_DIR=./storage

# Max upload size in bytes (default 10 MiB)
MAX_UPLOAD_BYTES=10485760

# swiyu Generic Verifier (sidecar)
# Local dev: verifier compose maps 8083 -> verifier container 8080. In compose, use http://verifier-service:8080.
SWIYU_VERIFIER_BASE_URL=http://localhost:8083
# Beta-ID (BCS) issuer DID — the credential issuer whose presentations we accept.
SWIYU_VERIFIER_ISSUER_DID=did:webvh:QmdPxnNc9MzGYZ6qcHuvi8YpDVYWW7mmefnCTPcKapNEL5:identifier-reg.trust-infra.swiyu-int.admin.ch:api:v1:did:5f8a3c95-1772-4ebf-ada0-c88bafb258e1

# vqPS (Verification Query Public Statement) — must match the statement published in the Trust Registry
VQPS_SCOPE=com.example.identityCardCredential_presentation
VQPS_PURPOSE_NAME=name verification
VQPS_PURPOSE_DESCRIPTION=This purpose allows verification of name for a test

# Sessions (httpOnly cookie) — generate: openssl rand -base64 32
SESSION_SECRET=
SESSION_TTL_SECONDS=1800

# Server key-encryption-key (wraps vault master keys at rest) — generate: openssl rand -base64 32
SERVER_KEK=

# ── swiyu Generic Verifier sidecar (used by docker-compose.yml) ──
# Fill these to start the verifier sidecar via `podman compose up`.
# EXTERNAL_URL must be an https URL reachable by the swiyu Wallet (e.g. a cloudflared/ngrok tunnel
# pointed at the verifier's /oid4vp port).
EXTERNAL_URL=
VERIFIER_DID=did:webvh:<your-verifier-did>
# e.g. did:webvh:...#auth-key-01 (the assertion/auth method fragment of VERIFIER_DID)
DID_VERIFICATION_METHOD=
# Deeplink scheme of the generated QR code. `swiyu-verify-sandbox` for the Sandbox Wallet,
# `swiyu-verify` for the regular production app.
DEEPLINK_SCHEMA=swiyu-verify-sandbox
# EC P-256 private key PEM (multi-line). Prefer a file/secret mount rather than inline .env.
SIGNING_KEY=
VERIFIER_POSTGRES_PASSWORD=verifier_secret
