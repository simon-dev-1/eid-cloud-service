# ── Runtime ────────────────────────────────────────────────────────────────────
# local | sandbox | production
ENVIRONMENT=local
PORT=3000
LOG_LEVEL=info
# Origin of the portal that talks to this API. Required (and https) outside "local".
# Used for CORS and CSRF origin checks when the API is reached cross-origin.
APP_ORIGIN=

# ── HTTP / security ────────────────────────────────────────────────────────────
# Set to true behind a reverse proxy (Caddy) so client IPs are resolved correctly.
HTTP_TRUST_PROXY=false
HTTP_RATE_LIMIT_ENABLED=true
HTTP_RATE_LIMIT_WINDOW_MS=60000
HTTP_RATE_LIMIT_MAX=1000
HTTP_RATE_LIMIT_VERIFICATION_MAX=10
HTTP_RATE_LIMIT_UPLOAD_MAX=30

# ── PostgreSQL ─────────────────────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=eid
POSTGRES_PASSWORD=eid
POSTGRES_DATABASE=eid
# disable | require | verify-full (use for managed DBaaS with TLS)
POSTGRES_SSL=disable
# Optional CA certificate (PEM) when POSTGRES_SSL=verify-full and the CA is private.
POSTGRES_SSL_CA=
POSTGRES_POOL_MIN=1
POSTGRES_POOL_MAX=10
POSTGRES_CONNECTION_TIMEOUT_MS=10000

# ── File storage ───────────────────────────────────────────────────────────────
# disk | s3
STORAGE_DRIVER=disk
# Local disk path (only used when STORAGE_DRIVER=disk)
STORAGE_DIR=./storage
# S3-compatible object storage (only used when STORAGE_DRIVER=s3).
# Exoscale SOS: S3_ENDPOINT=https://sos-ch-gva-2.exo.io, S3_REGION=ch-gva-2
S3_ENDPOINT=
S3_REGION=ch-gva-2
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true

# Max upload size in bytes (default 10 MiB)
MAX_UPLOAD_BYTES=10485760

# ── swiyu Generic Verifier (integration) ──────────────────────────────────────
# Local dev: verifier compose maps 8083 -> verifier container 8080. In compose, use http://verifier-service:8080.
SWIYU_VERIFIER_BASE_URL=http://localhost:8083
# Beta-ID (BCS) issuer DID — the credential issuer whose presentations we accept.
SWIYU_VERIFIER_ISSUER_DID=did:webvh:QmdPxnNc9MzGYZ6qcHuvi8YpDVYWW7mmefnCTPcKapNEL5:identifier-reg.trust-infra.swiyu-int.admin.ch:api:v1:did:5f8a3c95-1772-4ebf-ada0-c88bafb258e1
# Legacy did:tdw issuer DID kept so Beta-IDs issued before the migration still verify.
SWIYU_VERIFIER_LEGACY_ISSUER_DID=did:tdw:QmPEZPhDFR4nEYSFK5bMnvECqdpf1tPTPJuWs9QrMjCumw:identifier-reg.trust-infra.swiyu-int.admin.ch:api:v1:did:9a5559f0-b81c-4368-a170-e7b4ae424527
# Credential id used in the DCQL query.
SWIYU_VERIFIER_CREDENTIAL_ID=identity_credential
# Comma-separated list of accepted vct values.
SWIYU_VERIFIER_CREDENTIAL_VCTS=betaid-sdjwt,urn:vct:ch.admin.bcs.betaid
# Timeout (ms) for verifier management calls.
SWIYU_MANAGEMENT_TIMEOUT_MS=5000

# ── vqPS (Verification Query Public Statement) ────────────────────────────────
# Must match the statement published in the Trust Registry.
VQPS_SCOPE=com.example.identityCardCredential_presentation
VQPS_PURPOSE_NAME=name verification
VQPS_PURPOSE_DESCRIPTION=This purpose allows verification of name for a test

# ── Sessions (httpOnly cookie) ─────────────────────────────────────────────────
# Generate: openssl rand -base64 32
SESSION_SECRET=
SESSION_TTL_SECONDS=1800
SESSION_COOKIE_NAME=eid_session

# ── Server key-encryption-key (wraps vault master keys at rest) ────────────────
# Generate: openssl rand -base64 32  (must decode to exactly 32 bytes)
SERVER_KEK=

# ── swiyu Generic Verifier sidecar (used by docker-compose.yml) ────────────────
# Fill these to start the verifier sidecar via `podman compose up`.
# EXTERNAL_URL must be an https URL reachable by the swiyu Wallet (e.g. a cloudflared/ngrok tunnel
# pointed at the verifier's /oid4vp port).
EXTERNAL_URL=
VERIFIER_DID=did:webvh:<your-verifier-did>
# e.g. did:webvh:...#auth-key-01 (the assertion/auth method fragment of VERIFIER_DID)
DID_VERIFICATION_METHOD=
# Deeplink scheme of the generated QR code. `swiyu-verify-sandbox` for the Sandbox Wallet,
# `swiyu-verify` for the regular production app.
DEEPLINK_SCHEMA=swiyu-verify-sandbox
# EC P-256 private key PEM (multi-line). Prefer a file/secret mount rather than inline .env.
SIGNING_KEY=
# ── Optional: on-the-fly vqPS registration (removes the wallet's "request not registered"
#    warning). Leave empty to disable. Credentials from the swiyu API self-service portal.
SWIYU_TMS_AUTHORING_URL=
# Keycloak token endpoint — must include the trailing /token (the verifier POSTs here directly).
SWIYU_TMS_OAUTH_TOKEN_URL=
SWIYU_TMS_OAUTH_CLIENT_ID=
SWIYU_TMS_OAUTH_CLIENT_SECRET=
SWIYU_TMS_BOOTSTRAP_REFRESH_TOKEN=
# Read-only trust registry (defaults already set in the image; explicit for clarity)
SWIYU_TRUST_REGISTRY_API_URL=https://trust-reg.trust-infra.swiyu-int.admin.ch
SWIYU_TRUST_ISSUER_DID=did:webvh:QmdVPcfEJgvQAJKEjaTWAhskT1kc59KZQiXNenqHBB7iH5:identifier-reg.trust-infra.swiyu-int.admin.ch:api:v1:did:4c131dc4-ced1-454b-bbd4-9401c7512e37
VERIFIER_POSTGRES_PASSWORD=verifier_secret
