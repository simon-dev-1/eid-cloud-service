# Edge reverse proxy. Hosts are injected from the compose environment.
#   - app host  : serves the SPA and proxies /api/* to the API (same origin for cookies)
#   - verify host: exposes ONLY the wallet-facing /oid4vp/* paths; /management stays internal

{$APP_HOST} {
	encode zstd gzip

	handle /api/* {
		# Cap uploads just above MAX_UPLOAD_BYTES (10 MiB).
		request_body {
			max_size 12MB
		}
		reverse_proxy api:3000
	}

	handle {
		reverse_proxy portal:80
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
	}
}

{$VERIFY_HOST} {
	handle /oid4vp/* {
		reverse_proxy verifier-service:8080
	}

	# Everything else (including /management/**) is not public.
	respond 404
}
