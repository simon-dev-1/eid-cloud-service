# Production environment — API service variables.
# Copy to e.g. deploy/.env.production and fill in real values/secrets.
# Production swiyu values (issuer DIDs, trust registry, vqPS, credential types)
# must come from the swiyu production onboarding. Do NOT reuse integration values.

ENVIRONMENT=production
PORT=3000
LOG_LEVEL=info
APP_ORIGIN=https://app.eid-cloud.ch

HTTP_TRUST_PROXY=true
HTTP_RATE_LIMIT_ENABLED=true
HTTP_RATE_LIMIT_WINDOW_MS=60000
HTTP_RATE_LIMIT_MAX=120
HTTP_RATE_LIMIT_VERIFICATION_MAX=10
HTTP_RATE_LIMIT_UPLOAD_MAX=30

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=eid
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DATABASE=eid
# Use "require" or "verify-full" when pointing at a managed DBaaS endpoint.
POSTGRES_SSL=disable
POSTGRES_POOL_MIN=1
POSTGRES_POOL_MAX=10
POSTGRES_CONNECTION_TIMEOUT_MS=10000

# Move uploads to S3-compatible object storage before going live.
STORAGE_DRIVER=disk
STORAGE_DIR=/app/storage
# STORAGE_DRIVER=s3
# S3_ENDPOINT=https://sos-ch-gva-2.exo.io
# S3_REGION=ch-gva-2
# S3_BUCKET=eid-cloud-uploads
# S3_ACCESS_KEY_ID=CHANGE_ME
# S3_SECRET_ACCESS_KEY=CHANGE_ME
# S3_FORCE_PATH_STYLE=true

MAX_UPLOAD_BYTES=10485760

SWIYU_VERIFIER_BASE_URL=http://verifier-service:8080
# Production values — replace with the production issuer DID.
SWIYU_VERIFIER_ISSUER_DID=did:webvh:CHANGE_ME
SWIYU_VERIFIER_LEGACY_ISSUER_DID=
SWIYU_VERIFIER_CREDENTIAL_ID=identity_credential
SWIYU_VERIFIER_CREDENTIAL_VCTS=urn:vct:ch.admin.bcs.eid
SWIYU_MANAGEMENT_TIMEOUT_MS=5000

VQPS_SCOPE=CHANGE_ME
VQPS_PURPOSE_NAME=name verification
VQPS_PURPOSE_DESCRIPTION=CHANGE_ME

# Generate: openssl rand -base64 32
SESSION_SECRET=CHANGE_ME
SESSION_TTL_SECONDS=1800
SESSION_COOKIE_NAME=eid_session

# Generate: openssl rand -base64 32 (must decode to exactly 32 bytes)
SERVER_KEK=CHANGE_ME
