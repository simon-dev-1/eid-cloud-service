# Sandbox environment — API service variables (integration / Beta-ID).
# Copy to e.g. deploy/.env.sandbox and fill in the generated secrets.
# Verifier-side values (EXTERNAL_URL, VERIFIER_DID, SIGNING_KEY, ...) live in
# the compose environment file, not here.

ENVIRONMENT=sandbox
PORT=3000
LOG_LEVEL=info
APP_ORIGIN=https://sandbox.eid-cloud.ch

HTTP_TRUST_PROXY=true
HTTP_RATE_LIMIT_ENABLED=true
HTTP_RATE_LIMIT_WINDOW_MS=60000
HTTP_RATE_LIMIT_MAX=1000
HTTP_RATE_LIMIT_VERIFICATION_MAX=10
HTTP_RATE_LIMIT_UPLOAD_MAX=30

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=eid
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DATABASE=eid
POSTGRES_SSL=disable
POSTGRES_POOL_MIN=1
POSTGRES_POOL_MAX=10
POSTGRES_CONNECTION_TIMEOUT_MS=10000

STORAGE_DRIVER=disk
STORAGE_DIR=/app/storage

MAX_UPLOAD_BYTES=10485760

SWIYU_VERIFIER_BASE_URL=http://verifier-service:8080
SWIYU_VERIFIER_ISSUER_DID=did:webvh:QmdPxnNc9MzGYZ6qcHuvi8YpDVYWW7mmefnCTPcKapNEL5:identifier-reg.trust-infra.swiyu-int.admin.ch:api:v1:did:5f8a3c95-1772-4ebf-ada0-c88bafb258e1
SWIYU_VERIFIER_LEGACY_ISSUER_DID=did:tdw:QmPEZPhDFR4nEYSFK5bMnvECqdpf1tPTPJuWs9QrMjCumw:identifier-reg.trust-infra.swiyu-int.admin.ch:api:v1:did:9a5559f0-b81c-4368-a170-e7b4ae424527
SWIYU_VERIFIER_CREDENTIAL_ID=identity_credential
SWIYU_VERIFIER_CREDENTIAL_VCTS=betaid-sdjwt,urn:vct:ch.admin.bcs.betaid
SWIYU_MANAGEMENT_TIMEOUT_MS=5000

VQPS_SCOPE=com.example.identityCardCredential_presentation
VQPS_PURPOSE_NAME=name verification
VQPS_PURPOSE_DESCRIPTION=This purpose allows verification of name for a test

# Generate: openssl rand -base64 32
SESSION_SECRET=CHANGE_ME
SESSION_TTL_SECONDS=1800
SESSION_COOKIE_NAME=eid_session

# Generate: openssl rand -base64 32 (must decode to exactly 32 bytes)
SERVER_KEK=CHANGE_ME
