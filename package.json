{
  "name": "eid-cloud-service",
  "version": "0.1.0",
  "description": "Backend API for eid-cloud.ch — encrypted cloud vault (file upload/download)",
  "type": "module",
  "scripts": {
    "dev": "tsx --env-file=.env --watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig-build.json",
    "type-check": "tsc",
    "test": "node --env-file=.env --experimental-vm-modules node_modules/.bin/jest --config jest.config.js --ci --runInBand",
    "lint": "eslint --config ./eslint.config.ts --fix",
    "lint:check": "eslint --config ./eslint.config.ts --no-fix",
    "format": "prettier --write --ignore-unknown './{src,tests}/**/*' ./*",
    "format:check": "prettier . --check --ignore-unknown",
    "db-migrate": "tsx --env-file=.env ./node_modules/.bin/knex migrate:latest --knexfile src/knexfile.ts",
    "db-migrate-docker": "node ./node_modules/.bin/knex migrate:latest --knexfile dist/knexfile.js"
  },
  "keywords": [
    "eid",
    "vault",
    "cloud",
    "swiyu"
  ],
  "author": {
    "name": "simon-dev-1"
  },
  "license": "MIT",
  "engines": {
    "npm": ">=10.0.0",
    "node": ">=24.0.0"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "express-rate-limit": "^8.7.5",
    "helmet": "^8.0.0",
    "knex": "^3.1.0",
    "multer": "^2.0.0",
    "pg": "^8.13.0",
    "pino": "^10.0.0",
    "pino-http": "^11.0.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@babel/core": "^7.28.0",
    "@babel/preset-env": "^7.28.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.0.0",
    "@types/node": "^26.0.0",
    "@types/pg": "^8.11.0",
    "@types/supertest": "^6.0.3",
    "eslint": "^9.33.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-unused-imports": "^4.2.0",
    "globals": "^16.2.0",
    "husky": "^9.1.7",
    "jest": "^30.0.0",
    "jiti": "^2.5.1",
    "prettier": "^3.5.0",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.1",
    "tsx": "^4.20.6",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.72.0"
  }
}
